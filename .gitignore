__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Claude Code のローカル設定(セッションごとの許可設定など。共有しない)
.claude/

# データディレクトリ(DB・ダンプはリポジトリ管理外)
data/*
!data/.gitkeep

# ローカルの環境設定(例は .env.example)
.env

# 実値を書いた単体定義(雛形は docker-compose.standalone.example.yml)。
# 置き場の絶対パス・接続先の IP を書き込んで使うものなのでコミットしない
docker-compose.standalone.yml

# notes(短期記憶)の DB。ユーザーが書いた内容そのものなのでコミットしない
notes/

# 管理画面から入れた設定(話す相手の on/off・API キー)。API キーが入るのでコミットしない。
# ディレクトリ自体は残す(マウント先が無いと compose が root 所有で作ってしまう)ので、
# `state/` ではなく `state/*` にして .gitkeep だけ通す。
state/*
!state/.gitkeep

# 「答える」層の GGUF キャッシュ(数 GB。イメージにも repo にも入れない)
models/

# 別マシンへ持ち出す ingest イメージの置き場(docker save の成果物。手順書は
# docs/build-on-another-machine.md にあるので、このフォルダは丸ごと管理外)
handoff/

# やること画面(Vue)のビルド成果物と依存。イメージの中でビルドするのでコミットしない
tasks-frontend/node_modules/
tasks-frontend/dist/
